# Copia este archivo a .env.local y completa con los datos de tu proyecto Supabase.
# Solo la anon key (pública, protegida por RLS). NUNCA la service_role.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Site key pública de Cloudflare Turnstile (vacía = sin captcha, solo para desarrollo).
VITE_TURNSTILE_SITE_KEY=

# Ruta base: "/" en local/Vercel, "/finanzas-personales/" en GitHub Pages.
VITE_BASE=/
