{
  "name": "finanzas-personales",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "lint": "eslint . --max-warnings 0",
    "seed": "node --env-file=scripts/.env.scripts scripts/seed.mjs",
    "test:isolation": "node --env-file=scripts/.env.scripts scripts/test-isolation.mjs",
    "test:unit": "node --test --experimental-strip-types --no-warnings src/lib/*.test.ts src/features/*/*.test.ts",
    "test:sql": "bash scripts/test-sql.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/auth-js": "^2.118.0",
    "@supabase/postgrest-js": "^2.118.0",
    "lucide-react": "^1.59.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.4"
  }
}
